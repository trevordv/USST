# Database
DATABASE_URL=

# Application
PORT=5000
BASE_PATH=/
APP_URL=
NODE_ENV=production

# OpenAI - direct official API integration
OPENAI_API_KEY=
OPENAI_MODEL=

# Supabase - server-side Auth verification
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Supabase - frontend Auth (Vite build-time variables)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Source credentials
ALTENERGY_USERNAME=
ALTENERGY_PASSWORD=
LUVI_USERNAME=
LUVI_PASSWORD=
BROWSE_AI_API_KEY=
BROWSE_AI_NZ_FAST_TRACK_ROBOT_ID=
BROWSE_AI_NZ_EPA_FAST_TRACK_ROBOT_ID=
BROWSE_AI_NZ_EPA_RMA_ROBOT_ID=
BROWSE_AI_NZ_EPA_CONSULTATIONS_ROBOT_ID=

# Enrichment / scraping providers
APIFY_API_TOKEN=
LUSHA_API_KEY=
# Automatic Lusha lookup for each scan's new projects (default true when LUSHA_API_KEY is set).
# It also requires LUSHA_MAX_CREDITS_PER_REQUEST, set from the account plan.
LUSHA_AUTO_ENRICH_NEW_PROJECTS=
# Lusha credit cap per scan for that lookup (default 25, maximum 100).
LUSHA_SCAN_MAX_CREDITS=
# Highest number of account credits any one Lusha HTTP request can consume.
# Required for automatic Lusha enrichment so the scan can reserve a hard upper bound.
LUSHA_MAX_CREDITS_PER_REQUEST=
FIRECRAWL_API_KEY=
# Optional operator-set provider dispatch interval in milliseconds; defaults to 0.
FIRECRAWL_MIN_REQUEST_INTERVAL_MS=
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_ZONE=

# Optional local Scrapling acquisition; disabled unless explicitly enabled.
SCRAPLING_ENABLED=
SCRAPLING_SOURCES=
SCRAPLING_PYTHON=
SCRAPLING_SCRIPT=
PLAYWRIGHT_BROWSERS_PATH=
